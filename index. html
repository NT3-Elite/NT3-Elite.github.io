let items = JSON.parse(localStorage.getItem('nt3_anime')||'[]');
let currentFilter='all';
const grid=document.getElementById('contentGrid');
const totalCount=document.getElementById('totalCount');
const videoCount=document.getElementById('videoCount');
const imageCount=document.getElementById('imageCount');
const needCount=document.getElementById('needCount');

function save(){localStorage.setItem('nt3_anime',JSON.stringify(items)); render();}

function render(){
  const filtered = items.filter(it=>{
    if(currentFilter==='all') return true;
    if(currentFilter==='video' || currentFilter==='image') return it.type===currentFilter;
    if(currentFilter==='kerak') return it.status==='kerak';
    if(currentFilter==='kerakmas') return it.status==='kerakmas';
    return true;
  });
  grid.innerHTML = filtered.map(it=>`
    <div class="card">
      ${it.type==='video'?`<video src="${it.src}" class="thumb" muted></video>`:`<img src="${it.src}" class="thumb">`}
      <div class="card-body">
        <h4>${it.title}</h4>
        <div class="meta">${it.anime} • ${it.date}</div>
        <span class="badge ${it.status}">${it.status==='kerak'?'Kerak':it.status==='kerakmas'?'Kerak emas':'Tekshirilmagan'}</span>
        <div class="actions">
          <button class="btn-kerak" onclick="setStatus('${it.id}','kerak')">Kerak</button>
          <button class="btn-kerakmas" onclick="setStatus('${it.id}','kerakmas')">Kerak emas</button>
          <button class="btn-del" onclick="delItem('${it.id}')">O'chirish</button>
        </div>
      </div>
    </div>
  `).join('') || '<p style="color:#666;text-align:center;grid-column:1/-1">Hali hech narsa yuklanmagan</p>';

  totalCount.textContent=items.length;
  videoCount.textContent=items.filter(i=>i.type==='video').length;
  imageCount.textContent=items.filter(i=>i.type==='image').length;
  needCount.textContent=items.filter(i=>i.status==='kerak').length;
}

window.setStatus=(id,status)=>{
  const it=items.find(i=>i.id===id); if(it){it.status=status; save();}
}
window.delItem=(id)=>{
  items=items.filter(i=>i.id!==id); save();
}

document.getElementById('uploadBtn').onclick=()=>{
  const file=document.getElementById('fileInput').files[0];
  const title=document.getElementById('titleInput').value.trim();
  const anime=document.getElementById('animeSelect').value;
  const type=document.getElementById('typeSelect').value;
  if(!title){alert('Iltimos sarlavha yozing');return;}
  if(!file){alert('Fayl tanlang');return;}
  const reader=new FileReader();
  reader.onload=e=>{
    items.unshift({
      id:Date.now().toString(),
      title, anime, type,
      src:e.target.result,
      status:'tekshirilmagan',
      date:new Date().toLocaleDateString('uz-UZ')
    });
    save();
    document.getElementById('titleInput').value='';
    document.getElementById('fileInput').value='';
  };
  reader.readAsDataURL(file);
};

// drag drop
const drop=document.getElementById('dropArea');
drop.addEventListener('dragover',e=>{e.preventDefault();drop.style.borderColor='#a78bfa'});
drop.addEventListener('dragleave',()=>{drop.style.borderColor='#a78bfa55'});
drop.addEventListener('drop',e=>{
  e.preventDefault();drop.style.borderColor='#a78bfa55';
  document.getElementById('fileInput').files=e.dataTransfer.files;
});

// filters
document.querySelectorAll('.filter').forEach(b=>{
  b.onclick=()=>{
    document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    currentFilter=b.dataset.filter; render();
  }
});

render();