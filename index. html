*{margin:0;padding:0;box-sizing:border-box}
body{background:#0a0a12;color:#fff;font-family:Inter,sans-serif;overflow-x:hidden}
.bg-glow{position:fixed;top:-20%;left:-20%;width:140%;height:140%;background:radial-gradient(circle at 30% 20%,#7c3aed33,transparent 50%),radial-gradient(circle at 80% 80%,#ec489933,transparent 50%);filter:blur(40px);z-index:-1}
header{display:flex;justify-content:space-between;align-items:center;padding:20px 5%;background:rgba(255,255,255,0.05);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,255,255,0.1)}
.logo{font-family:Orbitron;font-size:22px;font-weight:800}.logo span{color:#a78bfa}
nav a{color:#ccc;margin-left:20px;text-decoration:none}.nav a:hover{color:#fff}
.hero{padding:60px 5%;text-align:center}
.hero-card{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:24px;padding:40px;max-width:700px;margin:0 auto;backdrop-filter:blur(12px)}
.hero-avatar{width:100px;height:100px;border-radius:50%;border:3px solid #a78bfa;margin-bottom:15px}
.hero-card h1{font-family:Orbitron;font-size:28px;margin-bottom:8px}
.hero-card p{color:#aaa;margin-bottom:20px}
.social-links{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn{padding:12px 22px;border-radius:12px;text-decoration:none;font-weight:600;transition:.2s}
.insta{background:#a78bfa;color:#000}.tg{background:#229ED9;color:#fff}.btn:hover{transform:translateY(-2px)}
.container{max-width:1100px;margin:0 auto;padding:0 5% 80px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px}
.stat{background:rgba(255,255,255,0.05);border-radius:16px;padding:18px;text-align:center;border:1px solid rgba(255,255,255,0.08)}
.stat span{font-size:28px;font-weight:800;color:#a78bfa}.stat p{color:#aaa;font-size:13px;margin-top:4px}
.upload-box{background:rgba(255,255,255,0.05);border:2px dashed #a78bfa55;border-radius:20px;padding:24px;margin-bottom:24px;text-align:center}
.upload-box h3{margin-bottom:6px}.upload-box p{color:#888;font-size:13px;margin-bottom:14px}
.upload-box input[type=text], .upload-box select{width:100%;padding:12px;margin:6px 0;background:#11111a;border:1px solid rgba(255,255,255,0.1);border-radius:10px;color:#fff}
.row{display:flex;gap:10px}
.row select{flex:1}
.upload-box input[type=file]{margin:10px 0;color:#aaa}
#uploadBtn{width:100%;padding:14px;background:linear-gradient(90deg,#7c3aed,#ec4899);border:none;border-radius:12px;color:#fff;font-weight:700;cursor:pointer;margin-top:10px}
#uploadBtn:hover{opacity:.9}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.filter{padding:8px 16px;border-radius:20px;border:1px solid rgba(255,255,255,0.15);background:transparent;color:#aaa;cursor:pointer}
.filter.active{background:#a78bfa;color:#000;border-color:#a78bfa}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.card{background:rgba(255,255,255,0.05);border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,0.08);transition:.2s}
.card:hover{transform:translateY(-4px);border-color:#a78bfa55}
.thumb{width:100%;height:160px;object-fit:cover;background:#111}
.card-body{padding:12px}
.card-body h4{font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card-body .meta{font-size:12px;color:#888;margin:4px 0}
.badge{font-size:11px;padding:3px 8px;border-radius:10px;background:#333;color:#aaa}
.badge.kerak{background:#22c55e33;color:#22c55e}.badge.kerakmas{background:#ef444433;color:#ef4444}
.actions{display:flex;gap:6px;margin-top:10px}
.actions button{flex:1;padding:8px;border-radius:8px;border:none;cursor:pointer;font-size:12px;font-weight:600}
.btn-kerak{background:#22c55e22;color:#22c55e;border:1px solid #22c55e44}.btn-kerakmas{background:#ef444422;color:#ef4444;border:1px solid #ef444444}.btn-del{background:rgba(255,255,255,0.07);color:#888}
footer{background:#11111a;border-top:1px solid rgba(255,255,255,0.1);padding:40px 5%;text-align:center;margin-top:60px}
footer h3{margin-bottom:12px}footer a{color:#a78bfa;text-decoration:none}
.warn{margin-top:14px;color:#fbbf24;font-size:12px}.copy{margin-top:14px;color:#555;font-size:12px}
@media(max-width:600px){.stats{grid-template-columns:repeat(2,1fr)}.row{flex-direction:column}}